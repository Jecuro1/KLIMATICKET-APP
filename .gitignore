# Xcode
*.xcodeproj/
*.xcworkspace/
!Packages/**/*.xcworkspace
xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Secrets (never commit real keys)
Config/Secrets.xcconfig
*.p12
*.mobileprovision
AuthKey_*.p8

# Cloudflare backend (rendered wrangler.toml, local state, secret files: see backend/.gitignore)
.wrangler/
.dev.vars
kb-secrets.json
kb-stale.json

# OS / tools
.DS_Store
node_modules/
__pycache__/

# Official logos (docs/LOGO_SPEC.md §1): ski-area / region logos live only in the Cloudflare logo pack, never in the
# repo (tools/check_no_brand_logos.py guards it in CI). Landeswappen are bundled under Assets.xcassets/Wappen.
*.logopack.zip
logo-pack/
brands/
