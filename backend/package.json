{
  "name": "klimabilanz-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KlimaBilanz cloud backend: Cloudflare Worker + D1 (auth, sync). Contract: docs/CLOUDFLARE_BACKEND.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.template.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build:dry": "wrangler deploy --dry-run --outdir dist -c wrangler.template.toml"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.8",
    "@cloudflare/workers-types": "5.20260930.2",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  }
}
